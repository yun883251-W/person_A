# 统一换行符：仓库内存 LF，检出到工作区也是 LF。
# 避免 Windows（core.autocrlf=true）与 Linux/macOS 之间出现整文件改动的假 diff，
# 也避免 docs/ 被工具改写换行符后 content_hash 变化、触发整库重新索引。
* text=auto eol=lf

# 项目文本文件显式声明
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
.env.example text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Windows 批处理必须保留 CRLF，否则可能无法执行
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不参与换行符转换与 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.npy   binary
*.parquet binary
