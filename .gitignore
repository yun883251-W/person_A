# 本地凭据
.env
.env.*
!.env.example

# Python 环境与缓存
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# 运行时生成的知识库数据
# 发布索引时整个 data/index 目录会被原子替换（os.replace + rmtree 旧目录），
# 所以不要在其中跟踪任何占位文件 —— 每次建库都会被删除。
data/index/*
# 建库/更新被强杀时遗留的临时目录（.index.build-* / .index.update-* / .index.backup-*）
data/.index.*/

# 本地会话数据库及 SQLite 辅助文件（包含聊天记录）
data/sessions/

# 测试运行残留：验证脚本在项目根目录留下的临时库与目录（含运行时 chat.db）
verification-tmp-*/
.pytest-tmp-*/
# pytest tmp_path_factory 的根目录，内含逐用例的 chat.db
.tmp/

# 日志
logs/
*.log

# 编辑器与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db
