# 配置模板；实际 API Key 仅填写在本地 .env 中。
# 路径应按项目根目录解析。
KNOWLEDGE_DOCS_DIR=./docs
KNOWLEDGE_INDEX_DIR=./data/index

# 对话模型：DeepSeek；模型名填写所选的可用 API 模型。
CHAT_PROVIDER=deepseek
CHAT_MODEL=
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_REQUEST_TIMEOUT=60
CHAT_MAX_RETRIES=2
# 留空时使用提供方默认值
CHAT_TEMPERATURE=
CHAT_MAX_OUTPUT_TOKENS=

# Embedding 模型：文档与问题使用同一套配置
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434

# 初始检索条数，待后续评估调整
RETRIEVAL_TOP_K=5
RETRIEVAL_VECTOR_CANDIDATES=20
RETRIEVAL_KEYWORD_CANDIDATES=20
RETRIEVAL_RRF_K=60
