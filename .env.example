# 配置模板；实际 API Key 仅填写在本地 .env 中。
# 路径应按项目根目录解析。
KNOWLEDGE_DOCS_DIR=./docs
KNOWLEDGE_INDEX_DIR=./data/index

# 本地 SQLite 会话存储
SESSION_DB_PATH=./data/sessions/chat.db
SESSION_DB_LOCK_TIMEOUT=5

# 对话模型：DeepSeek；模型名填写所选的可用 API 模型。
CHAT_PROVIDER=deepseek
CHAT_MODEL=
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_REQUEST_TIMEOUT=60
CHAT_MAX_RETRIES=2
# 留空时使用提供方默认值
CHAT_TEMPERATURE=
CHAT_MAX_OUTPUT_TOKENS=

# 自动 Skill 选择算法；请求中的 off/auto/manual 决定是否启用选择。
# rules 不增加模型调用；hybrid 仅规则无匹配时尝试一次，并为回答预留调用预算。
SKILL_SELECTION_MODE=rules
SKILL_SELECTION_MAX_CANDIDATES=32
SKILL_SELECTION_MAX_CATALOG_CHARS=8000
SKILL_SELECTION_MAX_HISTORY_ITEMS=6
SKILL_SELECTION_MAX_HISTORY_CHARS=4000

# 本地 MBTI MCP 配置；显式留空表示关闭 MCP，未配置此键时使用随项目配置
MCP_CONFIG_PATH=./config/mcp_servers.json

# Embedding 模型：文档与问题使用同一套配置
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434

# 初始检索条数，待后续评估调整
RETRIEVAL_TOP_K=5
RETRIEVAL_VECTOR_CANDIDATES=20
RETRIEVAL_KEYWORD_CANDIDATES=20
RETRIEVAL_RRF_K=60
