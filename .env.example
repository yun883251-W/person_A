# 本地配置占位；模型尚未选定，以下凭据均为空。
# 路径应按项目根目录解析。
KNOWLEDGE_DOCS_DIR=./docs
KNOWLEDGE_INDEX_DIR=./data/index

# 对话模型
CHAT_MODEL=
CHAT_API_KEY=
CHAT_BASE_URL=

# Embedding 模型：文档与问题使用同一套配置
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434

# 初始检索条数，待后续评估调整
RETRIEVAL_TOP_K=5
RETRIEVAL_VECTOR_CANDIDATES=20
RETRIEVAL_KEYWORD_CANDIDATES=20
RETRIEVAL_RRF_K=60
